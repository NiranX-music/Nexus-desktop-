{
  "mailer_subjects_confirmation": "Your Nexus Agent verification code",
  "mailer_templates_confirmation_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px 32px 20px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"88\" height=\"88\" style=\"display:block;margin:0 auto 16px;border-radius:20px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:28px;line-height:1.2;color:#ffffff;\">Email verification code</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.6;\">Enter this 8-digit code in Nexus Agent to verify your email and continue securely.</p></div><div style=\"padding:0 32px 32px;\"><div style=\"background:#091311;border:1px solid #17362d;border-radius:18px;padding:20px;\"><p style=\"margin:0 0 10px;color:#8ab1a3;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;\">Verification code</p><div style=\"background:#07110f;border:1px solid #21463a;border-radius:14px;padding:14px 18px;font-size:28px;font-weight:700;letter-spacing:6px;color:#ffffff;text-align:center;\">{{ .Token }}</div><p style=\"margin:18px 0 0;color:#d8fff2;font-size:14px;line-height:1.7;\">Use only the newest code. If an older Nexus email link was opened anywhere, request a fresh code before trying again.</p></div><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If you did not request this email, you can safely ignore it.</p></div></div><p style=\"margin:18px 0 0;text-align:center;color:#59786d;font-size:12px;\">Powered by Nexus Agent · https://niranx-nexus-agent.vercel.app</p></div></body></html>",
  "mailer_subjects_invite": "Create your Nexus Agent password",
  "mailer_templates_invite_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px 32px 20px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"88\" height=\"88\" style=\"display:block;margin:0 auto 16px;border-radius:20px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:28px;line-height:1.2;color:#ffffff;\">Create your password</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.6;\">You have been invited to join Nexus Agent. Continue below to activate your access and finish account setup.</p></div><div style=\"padding:0 32px 32px;\"><div style=\"background:#091311;border:1px solid #17362d;border-radius:18px;padding:20px;\"><p style=\"margin:0 0 18px;color:#d8fff2;font-size:14px;line-height:1.7;\">Open the secure invite to continue to password setup.</p><p style=\"margin:0 0 18px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#63f5bb;color:#04110d;text-decoration:none;font-weight:700;padding:14px 22px;border-radius:14px;\">Accept invite</a></p><p style=\"margin:0 0 10px;color:#8ab1a3;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;\">Setup code</p><div style=\"background:#07110f;border:1px solid #21463a;border-radius:14px;padding:14px 18px;font-size:28px;font-weight:700;letter-spacing:6px;color:#ffffff;text-align:center;\">{{ .Token }}</div></div><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If you were not expecting this invite, ignore this email.</p></div></div><p style=\"margin:18px 0 0;text-align:center;color:#59786d;font-size:12px;\">Powered by Nexus Agent · https://niranx-nexus-agent.vercel.app</p></div></body></html>",
  "mailer_subjects_magic_link": "Your Nexus Agent verification code",
  "mailer_templates_magic_link_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px 32px 20px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"88\" height=\"88\" style=\"display:block;margin:0 auto 16px;border-radius:20px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:28px;line-height:1.2;color:#ffffff;\">Sign in with this code</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.6;\">Enter this 8-digit code in Nexus Agent to finish sign-in.</p></div><div style=\"padding:0 32px 32px;\"><div style=\"background:#091311;border:1px solid #17362d;border-radius:18px;padding:20px;\"><p style=\"margin:0 0 10px;color:#8ab1a3;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;\">Sign-in code</p><div style=\"background:#07110f;border:1px solid #21463a;border-radius:14px;padding:14px 18px;font-size:28px;font-weight:700;letter-spacing:6px;color:#ffffff;text-align:center;\">{{ .Token }}</div><p style=\"margin:18px 0 0;color:#d8fff2;font-size:14px;line-height:1.7;\">Use only the newest code. If an older Nexus email link was opened anywhere, request a fresh code before trying again.</p></div><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If you did not request this email, you can ignore it.</p></div></div><p style=\"margin:18px 0 0;text-align:center;color:#59786d;font-size:12px;\">Powered by Nexus Agent · https://niranx-nexus-agent.vercel.app</p></div></body></html>",
  "mailer_subjects_recovery": "Reset your Nexus Agent password",
  "mailer_templates_recovery_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px 32px 20px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"88\" height=\"88\" style=\"display:block;margin:0 auto 16px;border-radius:20px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:28px;line-height:1.2;color:#ffffff;\">Reset your password</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.6;\">We received a request to reset your Nexus Agent password.</p></div><div style=\"padding:0 32px 32px;\"><div style=\"background:#091311;border:1px solid #17362d;border-radius:18px;padding:20px;\"><p style=\"margin:0 0 18px;color:#d8fff2;font-size:14px;line-height:1.7;\">Use the secure button below to continue.</p><p style=\"margin:0 0 18px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#63f5bb;color:#04110d;text-decoration:none;font-weight:700;padding:14px 22px;border-radius:14px;\">Reset password</a></p><p style=\"margin:0 0 10px;color:#8ab1a3;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;\">Reset code</p><div style=\"background:#07110f;border:1px solid #21463a;border-radius:14px;padding:14px 18px;font-size:28px;font-weight:700;letter-spacing:6px;color:#ffffff;text-align:center;\">{{ .Token }}</div></div><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If you did not request a password reset, you can safely ignore this message.</p></div></div><p style=\"margin:18px 0 0;text-align:center;color:#59786d;font-size:12px;\">Powered by Nexus Agent · https://niranx-nexus-agent.vercel.app</p></div></body></html>",
  "mailer_subjects_reauthentication": "Your Nexus Agent security code",
  "mailer_templates_reauthentication_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px 32px 20px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"88\" height=\"88\" style=\"display:block;margin:0 auto 16px;border-radius:20px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:28px;line-height:1.2;color:#ffffff;\">Security verification</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.6;\">Use this one-time code to continue your sensitive action in Nexus Agent.</p></div><div style=\"padding:0 32px 32px;\"><div style=\"background:#07110f;border:1px solid #21463a;border-radius:16px;padding:18px;text-align:center;\"><div style=\"margin:0 0 10px;color:#8ab1a3;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;\">Security code</div><div style=\"font-size:30px;font-weight:700;letter-spacing:6px;color:#ffffff;\">{{ .Token }}</div></div><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If you did not request this verification, ignore this email.</p></div></div><p style=\"margin:18px 0 0;text-align:center;color:#59786d;font-size:12px;\">Powered by Nexus Agent · https://niranx-nexus-agent.vercel.app</p></div></body></html>",
  "mailer_subjects_email_change": "Confirm your new Nexus Agent email",
  "mailer_templates_email_change_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px 32px 20px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"88\" height=\"88\" style=\"display:block;margin:0 auto 16px;border-radius:20px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:28px;line-height:1.2;color:#ffffff;\">Confirm email change</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.6;\">We received a request to update your Nexus Agent email address.</p></div><div style=\"padding:0 32px 32px;\"><div style=\"background:#091311;border:1px solid #17362d;border-radius:18px;padding:20px;\"><p style=\"margin:0 0 12px;color:#d8fff2;font-size:14px;line-height:1.7;\">New email: <strong>{{ .NewEmail }}</strong></p><p style=\"margin:0 0 18px;\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#63f5bb;color:#04110d;text-decoration:none;font-weight:700;padding:14px 22px;border-radius:14px;\">Confirm new email</a></p><p style=\"margin:0 0 10px;color:#8ab1a3;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;\">Confirmation code</p><div style=\"background:#07110f;border:1px solid #21463a;border-radius:14px;padding:14px 18px;font-size:28px;font-weight:700;letter-spacing:6px;color:#ffffff;text-align:center;\">{{ .Token }}</div></div><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If this was not requested by you, secure your account immediately.</p></div></div><p style=\"margin:18px 0 0;text-align:center;color:#59786d;font-size:12px;\">Powered by Nexus Agent · https://niranx-nexus-agent.vercel.app</p></div></body></html>",
  "mailer_notifications_password_changed_enabled": true,
  "mailer_subjects_password_changed_notification": "Your Nexus Agent password was changed",
  "mailer_templates_password_changed_notification_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"72\" height=\"72\" style=\"display:block;margin:0 auto 16px;border-radius:18px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:26px;line-height:1.2;color:#ffffff;\">Password changed</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.7;\">This confirms that the password for <strong>{{ .Email }}</strong> was changed.</p><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If this was not you, reset your password immediately and review your account activity.</p></div></div></div></body></html>",
  "mailer_notifications_email_changed_enabled": true,
  "mailer_subjects_email_changed_notification": "Your Nexus Agent email was changed",
  "mailer_templates_email_changed_notification_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"72\" height=\"72\" style=\"display:block;margin:0 auto 16px;border-radius:18px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:26px;line-height:1.2;color:#ffffff;\">Email address changed</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.7;\">Your Nexus Agent email address has been updated from <strong>{{ .OldEmail }}</strong> to <strong>{{ .Email }}</strong>.</p><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If this was not you, secure your account immediately.</p></div></div></div></body></html>",
  "mailer_notifications_phone_changed_enabled": true,
  "mailer_subjects_phone_changed_notification": "Your Nexus Agent phone number was changed",
  "mailer_templates_phone_changed_notification_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"72\" height=\"72\" style=\"display:block;margin:0 auto 16px;border-radius:18px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:26px;line-height:1.2;color:#ffffff;\">Phone number changed</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.7;\">The phone number on your Nexus Agent account changed from <strong>{{ .OldPhone }}</strong> to <strong>{{ .Phone }}</strong>.</p><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If this was not you, secure your account immediately.</p></div></div></div></body></html>",
  "mailer_notifications_mfa_factor_enrolled_enabled": true,
  "mailer_subjects_mfa_factor_enrolled_notification": "A new Nexus Agent MFA method was added",
  "mailer_templates_mfa_factor_enrolled_notification_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"72\" height=\"72\" style=\"display:block;margin:0 auto 16px;border-radius:18px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:26px;line-height:1.2;color:#ffffff;\">MFA method added</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.7;\">A new MFA method (<strong>{{ .FactorType }}</strong>) was added to the account <strong>{{ .Email }}</strong>.</p><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If this was not you, remove the factor and secure your account.</p></div></div></div></body></html>",
  "mailer_notifications_mfa_factor_unenrolled_enabled": true,
  "mailer_subjects_mfa_factor_unenrolled_notification": "A Nexus Agent MFA method was removed",
  "mailer_templates_mfa_factor_unenrolled_notification_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"72\" height=\"72\" style=\"display:block;margin:0 auto 16px;border-radius:18px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:26px;line-height:1.2;color:#ffffff;\">MFA method removed</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.7;\">An MFA method (<strong>{{ .FactorType }}</strong>) was removed from the account <strong>{{ .Email }}</strong>.</p><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If this was not you, secure your account immediately.</p></div></div></div></body></html>",
  "mailer_notifications_identity_linked_enabled": true,
  "mailer_subjects_identity_linked_notification": "A new identity was linked to Nexus Agent",
  "mailer_templates_identity_linked_notification_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"72\" height=\"72\" style=\"display:block;margin:0 auto 16px;border-radius:18px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:26px;line-height:1.2;color:#ffffff;\">Identity linked</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.7;\">A new identity provider (<strong>{{ .Provider }}</strong>) was linked to <strong>{{ .Email }}</strong>.</p><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If this was not you, review your account security.</p></div></div></div></body></html>",
  "mailer_notifications_identity_unlinked_enabled": true,
  "mailer_subjects_identity_unlinked_notification": "An identity was removed from Nexus Agent",
  "mailer_templates_identity_unlinked_notification_content": "<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#07110f;color:#e7fff7;font-family:Arial,Helvetica,sans-serif;\"><div style=\"max-width:560px;margin:0 auto;padding:32px 20px;\"><div style=\"background:#0b1714;border:1px solid #17362d;border-radius:24px;overflow:hidden;\"><div style=\"padding:32px;text-align:center;\"><img src=\"https://niranx-nexus-agent.vercel.app/nexus-icon.jpg\" alt=\"Nexus Agent\" width=\"72\" height=\"72\" style=\"display:block;margin:0 auto 16px;border-radius:18px;\" /><div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#63f5bb;font-weight:700;\">Nexus Agent</div><h1 style=\"margin:12px 0 10px;font-size:26px;line-height:1.2;color:#ffffff;\">Identity unlinked</h1><p style=\"margin:0;color:#9fc7ba;font-size:15px;line-height:1.7;\">An identity provider (<strong>{{ .Provider }}</strong>) was removed from <strong>{{ .Email }}</strong>.</p><p style=\"margin:18px 0 0;color:#739487;font-size:13px;line-height:1.6;\">If this was not you, review your account security.</p></div></div></div></body></html>"
