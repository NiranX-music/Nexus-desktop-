# ==============================================================================
# Nexus Desktop Remote Bridge Environment Variables
# ==============================================================================

# Cloudflare D1 Edge API Endpoint:
# For local development with wrangler:
D1_API_URL=http://127.0.0.1:8788/api
# For production Cloudflare Pages deployment:
# D1_API_URL=https://nexus-desktop-bridge.pages.dev/api

# Optional bearer secret for request verification:
AUTH_SECRET=

# Polling frequency in seconds (2.0s gives near real-time edge responsiveness):
POLL_INTERVAL_SECONDS=2.0

# Heartbeat ping frequency in seconds (announces online presence):
HEARTBEAT_INTERVAL_SECONDS=30.0

# Unique identifier for this computer:
AGENT_ID=nexus-desktop-primary

# Local Nexus Desktop Electron App Bridge Port (default 17173, fallback 5173):
NEXUS_DESKTOP_PORT=17173
