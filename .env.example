# ==============================================================================
# 👁️ Nexus AI - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# WARNING: NEVER COMMIT YOUR ACTUAL `.env` FILE TO VERSION CONTROL!
# 
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env`
# 2. Replace the placeholder strings with your actual API keys.
#
# ARCHITECTURE NOTE: 
# In the compiled production app, users will input their own API keys via the 
# NEXUS Settings Dashboard, which encrypts them into the native OS Secure Vault.
# These environment variables are strictly used for local Vite development.
# ==============================================================================

# ------------------------------------------------------------------------------
# [ CLOUD & NETWORK ROUTING ]
# ------------------------------------------------------------------------------

# Target URL for the Node.js/Express Auth Backend
VITE_BACKEND_KEY = https://nexus-web-two.vercel.app

# Target URL for the Next.js Web Frontend (For Cloud Authentication)
VITE_FRONTEND_KEY = https://nexusaix.vercel.app

# Supabase project used by the desktop app for email/password auth and private
# per-user cloud memory. Use a publishable key, never a service role key.
VITE_SUPABASE_URL = https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY = sb_publishable_your_key_here
