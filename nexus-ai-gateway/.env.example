# Required on each Vercel and Netlify gateway deployment.
# Store this in provider environment variables, never in the repository.
NEXUS_AI_UPSTREAM_BASE_URL=https://integrate.api.nvidia.com/v1
NEXUS_AI_UPSTREAM_API_KEY=
NEXUS_AI_UPSTREAM_AUTH_HEADER=authorization
NEXUS_AI_UPSTREAM_AUTH_SCHEME=Bearer
NEXUS_AI_UPSTREAM_NAME=nvidia
NEXUS_AI_UPSTREAM_ALLOW_NO_KEY=false

# Backwards-compatible fallback accepted by the current gateway:
NVIDIA_API_KEY=

# Server-side Gemini live key for /api/gemini/status, /api/gemini/generate, and /api/gemini/embed.
NEXUS_GEMINI_API_KEY=
NEXUS_GEMINI_MODEL=gemini-2.5-flash
NEXUS_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Universal admin pass for the local api-edit page.
NEXUS_ADMIN_PASS=05122010

# Keep false so only the desktop app / admin tools can call AI endpoints.
NEXUS_ALLOW_PUBLIC_AI=false
