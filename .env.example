# ==============================================================================
# 👁️ Nexus AI - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# WARNING: NEVER COMMIT YOUR ACTUAL `.env` FILE TO VERSION CONTROL!
# 
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env`
# 2. Replace the placeholder strings with your actual API keys.
#
# ARCHITECTURE NOTE:
# Desktop apps must call your Nexus AI API gateway only. Keep provider keys on
# the API host in NEXUS_AI_UPSTREAM_API_KEY, not in the desktop app.
# These environment variables are strictly used for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# [ CLOUD & NETWORK ROUTING ]
# ------------------------------------------------------------------------------
NEXUS_AI_API_URL=https://niranx-nexus-agent.vercel.app
NEXUS_GEMINI_API_URL=https://niranx-nexus-agent.vercel.app
NEXUS_AI_GATEWAY_URLS=https://nexus-ai-gateway.vercel.app,https://nexus-ai-gateway-2.vercel.app,https://nexus-ai-gateway-3.vercel.app,https://nexus-ai-gateway.netlify.app,https://nexus-ai-gateway-2.netlify.app,https://nexus-ai-gateway-3.netlify.app
NEXUS_WEB_APP_URL=https://niranx-nexus-agent.vercel.app
VITE_NEXUS_WEB_APP_URL=https://niranx-nexus-agent.vercel.app
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Desktop login calls the hosted Nexus website, which performs the server-side
# Supabase device-code exchange using SUPABASE_SERVICE_ROLE_KEY in Vercel only.

# ------------------------------------------------------------------------------
# [ WINDOWS RELEASE SIGNING ]
# ------------------------------------------------------------------------------
# Never commit real certificate files, passwords, or Azure client secrets.
# Set these only in your local shell or secure CI/CD secret store before running:
# npm run build:win:signed
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
CSC_LINK=
CSC_KEY_PASSWORD=
WINDOWS_CERTIFICATE_SUBJECT_NAME=
WINDOWS_CERTIFICATE_SHA1=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TRUSTED_SIGNING_ENDPOINT=
AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE_NAME=
AZURE_TRUSTED_SIGNING_CODE_SIGNING_ACCOUNT_NAME=
AZURE_TRUSTED_SIGNING_PUBLISHER_NAME=
